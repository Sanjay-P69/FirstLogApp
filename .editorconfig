root = true

[*.{kt,kts}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
ktlint_code_style = android_studio
# Compose entry points follow Android's PascalCase convention.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Existing source packages contain Sanjay; changing namespace is a separate migration.
ktlint_standard_package-name = disabled
